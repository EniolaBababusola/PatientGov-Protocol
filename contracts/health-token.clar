;; health-token.clar

(define-fungible-token health-token u100000000)

(define-constant ERR-OWNER-ONLY u100)
(define-constant ERR-INSUFFICIENT-BALANCE u101)
(define-constant ERR-INVALID-AMOUNT u102)
(define-constant ERR-NOT-MINTER u103)
(define-constant ERR-PAUSED u104)
(define-constant ERR-BLACKLISTED u105)
(define-constant ERR-INVALID-ADDRESS u106)
(define-constant ERR-ALREADY-PAUSED u107)
(define-constant ERR-NOT-PAUSED u108)
(define-constant ERR-INVALID-ROLE u109)
(define-constant ERR-ALLOWANCE-INSUFFICIENT u110)
(define-constant ERR-SELF-TRANSFER u111)
(define-constant ERR-MINT-LIMIT-EXCEEDED u112)
(define-constant ERR-BURN-NOT-ALLOWED u113)
(define-constant ERR-TRANSFER-NOT-ALLOWED u114)
(define-constant ERR-APPROVE-NOT-ALLOWED u115)
(define-constant ERR-INVALID-MINT-AMOUNT u116)
(define-constant ERR-INVALID-BURN-AMOUNT u117)
(define-constant ERR-INVALID-TRANSFER-AMOUNT u118)
(define-constant ERR-INVALID-APPROVE-AMOUNT u119)
(define-constant ERR-MAX-MINTERS-EXCEEDED u120)

(define-data-var token-admin principal tx-sender)
(define-data-var is-paused bool false)
(define-data-var total-minted uint u0)
(define-data-var mint-limit uint u100000000)
(define-data-var max-minters uint u10)

(define-map allowances {owner: principal, spender: principal} uint)
(define-map minters principal bool)
(define-map blacklisted principal bool)
(define-map roles principal (string-ascii 20))

(define-read-only (get-balance (who principal))
  (ft-get-balance health-token who)
)

(define-read-only (get-total-supply)
  (ft-get-supply health-token)
)

(define-read-only (get-allowance (owner principal) (spender principal))
  (default-to u0 (map-get? allowances {owner: owner, spender: spender}))
)

(define-read-only (is-minter (account principal))
  (default-to false (map-get? minters account))
)

(define-read-only (is-blacklisted (account principal))
  (default-to false (map-get? blacklisted account))
)

(define-read-only (get-role (account principal))
  (default-to "none" (map-get? roles account))
)

(define-read-only (get-paused)
  (var-get is-paused)
)

(define-read-only (get-mint-limit)
  (var-get mint-limit)
)

(define-private (validate-amount (amount uint))
  (if (> amount u0)
    (ok true)
    (err ERR-INVALID-AMOUNT))
)

(define-private (validate-address (addr principal))
  (if (not (is-eq addr 'SP000000000000000000002Q6VF78))
    (ok true)
    (err ERR-INVALID-ADDRESS))
)

(define-private (validate-not-paused)
  (if (not (var-get is-paused))
    (ok true)
    (err ERR-PAUSED))
)

(define-private (validate-not-blacklisted (addr principal))
  (if (not (is-blacklisted addr))
    (ok true)
    (err ERR-BLACKLISTED))
)

(define-private (validate-is-owner)
  (if (is-eq tx-sender (var-get token-admin))
    (ok true)
    (err ERR-OWNER-ONLY))
)

(define-private (validate-is-minter)
  (if (is-minter tx-sender)
    (ok true)
    (err ERR-NOT-MINTER))
)

(define-private (validate-mint-limit (amount uint))
  (if (<= (+ (var-get total-minted) amount) (var-get mint-limit))
    (ok true)
    (err ERR-MINT-LIMIT-EXCEEDED))
)

(define-private (validate-no-self-transfer (sender principal) (recipient principal))
  (if (not (is-eq sender recipient))
    (ok true)
    (err ERR-SELF-TRANSFER))
)

(define-public (set-admin (new-admin principal))
  (begin
    (try! (validate-is-owner))
    (try! (validate-address new-admin))
    (var-set token-admin new-admin)
    (print {event: "admin-changed", new-admin: new-admin})
    (ok true)
  )
)

(define-public (add-minter (new-minter principal))
  (begin
    (try! (validate-is-owner))
    (try! (validate-address new-minter))
    (asserts! (not (is-minter new-minter)) (err ERR-INVALID-ROLE))
    (map-set minters new-minter true)
    (print {event: "minter-added", minter: new-minter})
    (ok true)
  )
)

(define-public (remove-minter (minter principal))
  (begin
    (try! (validate-is-owner))
    (asserts! (is-minter minter) (err ERR-INVALID-ROLE))
    (map-delete minters minter)
    (print {event: "minter-removed", minter: minter})
    (ok true)
  )
)

(define-public (pause)
  (begin
    (try! (validate-is-owner))
    (asserts! (not (var-get is-paused)) (err ERR-ALREADY-PAUSED))
    (var-set is-paused true)
    (print {event: "paused"})
    (ok true)
  )
)

(define-public (unpause)
  (begin
    (try! (validate-is-owner))
    (asserts! (var-get is-paused) (err ERR-NOT-PAUSED))
    (var-set is-paused false)
    (print {event: "unpaused"})
    (ok true)
  )
)

(define-public (blacklist-address (addr principal))
  (begin
    (try! (validate-is-owner))
    (try! (validate-address addr))
    (asserts! (not (is-blacklisted addr)) (err ERR-INVALID-ROLE))
    (map-set blacklisted addr true)
    (print {event: "blacklisted", address: addr})
    (ok true)
  )
)

(define-public (unblacklist-address (addr principal))
  (begin
    (try! (validate-is-owner))
    (asserts! (is-blacklisted addr) (err ERR-INVALID-ROLE))
    (map-delete blacklisted addr)
    (print {event: "unblacklisted", address: addr})
    (ok true)
  )
)

(define-public (set-mint-limit (new-limit uint))
  (begin
    (try! (validate-is-owner))
    (asserts! (>= new-limit (var-get total-minted)) (err ERR-INVALID-AMOUNT))
    (var-set mint-limit new-limit)
    (print {event: "mint-limit-set", limit: new-limit})
    (ok true)
  )
)

(define-public (mint (amount uint) (recipient principal))
  (begin
    (try! (validate-is-minter))
    (try! (validate-amount amount))
    (try! (validate-address recipient))
    (try! (validate-not-paused))
    (try! (validate-not-blacklisted recipient))
    (try! (validate-mint-limit amount))
    (try! (ft-mint? health-token amount recipient))
    (var-set total-minted (+ (var-get total-minted) amount))
    (print {event: "minted", amount: amount, recipient: recipient})
    (ok true)
  )
)

(define-public (burn (amount uint))
  (let
    (
      (burner tx-sender)
      (balance (get-balance burner))
    )
    (try! (validate-amount amount))
    (asserts! (>= balance amount) (err ERR-INSUFFICIENT-BALANCE))
    (try! (validate-not-paused))
    (try! (ft-burn? health-token amount burner))
    (print {event: "burned", amount: amount, burner: burner})
    (ok true)
  )
)

(define-public (transfer (amount uint) (recipient principal))
  (let
    (
      (sender tx-sender)
      (balance (get-balance sender))
    )
    (try! (validate-amount amount))
    (try! (validate-address recipient))
    (try! (validate-no-self-transfer sender recipient))
    (asserts! (>= balance amount) (err ERR-INSUFFICIENT-BALANCE))
    (try! (validate-not-paused))
    (try! (validate-not-blacklisted sender))
    (try! (validate-not-blacklisted recipient))
    (try! (ft-transfer? health-token amount sender recipient))
    (print {event: "transferred", amount: amount, from: sender, to: recipient})
    (ok true)
  )
)

(define-public (approve (spender principal) (amount uint))
  (let
    (
      (owner tx-sender)
    )
    (try! (validate-address spender))
    (try! (validate-amount amount))
    (try! (validate-not-paused))
    (try! (validate-not-blacklisted owner))
    (try! (validate-not-blacklisted spender))
    (map-set allowances {owner: owner, spender: spender} amount)
    (print {event: "approved", owner: owner, spender: spender, amount: amount})
    (ok true)
  )
)

(define-public (transfer-from (owner principal) (recipient principal) (amount uint))
  (let
    (
      (spender tx-sender)
      (allowance (get-allowance owner spender))
    )
    (try! (validate-address owner))
    (try! (validate-address recipient))
    (try! (validate-amount amount))
    (try! (validate-no-self-transfer owner recipient))
    (asserts! (>= allowance amount) (err ERR-ALLOWANCE-INSUFFICIENT))
    (try! (validate-not-paused))
    (try! (validate-not-blacklisted owner))
    (try! (validate-not-blacklisted recipient))
    (try! (validate-not-blacklisted spender))
    (try! (ft-transfer? health-token amount owner recipient))
    (map-set allowances {owner: owner, spender: spender} (- allowance amount))
    (print {event: "transferred-from", amount: amount, owner: owner, recipient: recipient, spender: spender})
    (ok true)
  )
)

(define-public (increase-allowance (spender principal) (amount uint))
  (let
    (
      (owner tx-sender)
      (current-allowance (get-allowance owner spender))
    )
    (try! (validate-address spender))
    (try! (validate-amount amount))
    (try! (validate-not-paused))
    (try! (validate-not-blacklisted owner))
    (try! (validate-not-blacklisted spender))
    (map-set allowances {owner: owner, spender: spender} (+ current-allowance amount))
    (print {event: "allowance-increased", owner: owner, spender: spender, amount: amount})
    (ok true)
  )
)

(define-public (decrease-allowance (spender principal) (amount uint))
  (let
    (
      (owner tx-sender)
      (current-allowance (get-allowance owner spender))
    )
    (try! (validate-address spender))
    (try! (validate-amount amount))
    (asserts! (>= current-allowance amount) (err ERR-ALLOWANCE-INSUFFICIENT))
    (try! (validate-not-paused))
    (try! (validate-not-blacklisted owner))
    (try! (validate-not-blacklisted spender))
    (map-set allowances {owner: owner, spender: spender} (- current-allowance amount))
    (print {event: "allowance-decreased", owner: owner, spender: spender, amount: amount})
    (ok true)
  )
)

(define-public (set-role (account principal) (role (string-ascii 20)))
  (begin
    (try! (validate-is-owner))
    (try! (validate-address account))
    (asserts! (or (is-eq role "admin") (is-eq role "minter") (is-eq role "none")) (err ERR-INVALID-ROLE))
    (map-set roles account role)
    (print {event: "role-set", account: account, role: role})
    (ok true)
  )
)